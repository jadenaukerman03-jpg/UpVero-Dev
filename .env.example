# Server-side only. Never use a VITE_ prefix for these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Server-side model for the high-quality website creative pass.
OPENAI_SITE_MODEL=gpt-5.4-mini
# Server-side only. Enables the approved Pexels image provider.
PEXELS_API_KEY=

# Supabase. VITE_* values are browser-safe; the secret key is server-only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe (server-side only). Configure matching Price IDs before enabling checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LAUNCH=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PROFESSIONAL=
# Public base URL of this UpVero deployment, used only server-side for Stripe return URLs.
UPVERO_APP_URL=https://your-domain.example
# Public support recipient displayed on the Upvero Contact page. This is an
# email address, not a secret. Leave unset until the mailbox exists.
VITE_UPVERO_SUPPORT_EMAIL=

# Server-side only. Optional contact-form notifications sent through Resend.
# Configure an authenticated sender at your email provider before enabling.
RESEND_API_KEY=
UPVERO_SUPPORT_FROM_EMAIL="Upvero Support <support@your-domain.example>"
UPVERO_SUPPORT_NOTIFICATION_EMAIL=
