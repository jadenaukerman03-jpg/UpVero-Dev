# Server-side only. Never use a VITE_ prefix for these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Server-side only. Enables the approved Pexels provider before AI fallback.
PEXELS_API_KEY=

# Supabase. VITE_* values are browser-safe; the secret key is server-only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe (server-side only). Configure matching Price IDs before enabling checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LAUNCH=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PROFESSIONAL=
# Public base URL of this UpVero deployment, used only server-side for Stripe return URLs.
UPVERO_APP_URL=https://your-domain.example
